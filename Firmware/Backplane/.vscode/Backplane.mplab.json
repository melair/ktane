{
    "version": "1.8",
    "configurations": [
        {
            "name": "Backplane",
            "id": "conf1",
            "device": "PIC18F25Q43",
            "imagePath": "./out/Backplane/default.elf",
            "tool": "PICkit 4",
            "packs": [
                {
                    "name": "PIC18F-Q_DFP",
                    "vendor": "Microchip",
                    "version": "1.30.487"
                }
            ],
            "fileSet": "default",
            "toolchain": "default-XC8"
        }
    ],
    "propertyGroups": [
        {
            "name": "default-XC8",
            "type": "toolchain",
            "provider": "microchip.toolchains:xc8@3.10",
            "properties": {
                "HI-TECH-LINK.code-model-rom": "200-7FFF",
                "HI-TECH-LINK.additional-options-code-offset": "200",
                "HI-TECH-COMP.asmlist": false
            }
        },
        {
            "name": "ControlBoard-tool-base",
            "type": "tool",
            "properties": {
                "poweroptions.powerenable": true,
                "voltagevalue": "3.3"
            }
        }
    ],
    "fileSets": [
        {
            "name": "default",
            "files": [
                {
                    "include": "**/*",
                    "exclude": "**/(_build|out|cmake|.vscode)/**/*"
                },
                {
                    "include": "../Bootloader/.vscode/Bootloader.mplab.json",
                    "projectType": "loadable",
                    "dependentConfigurationName": "Backplane"
                },
                {
                    "include": "../Common/.vscode/Common.mplab.json",
                    "projectType": "library",
                    "dependentConfigurationName": "Backplane"
                }
            ]
        }
    ]
}
