{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "MPLAB-CMake",
			"label": "Backplane: Backplane - Full Build",
			"action": "fullbuild",
			"buildType": "debug",
			"configName": "Backplane",
			"configPath": "${workspaceFolder}/.vscode/Backplane.mplab.json",
			"problemMatcher": [
				"$cmakeGenerate",
				"$cmakeBuildCompiler",
				"$cmakeBuildLinker",
				"$xc8Error1",
				"$xc8Error2",
				"$nonLineSpecific",
				"$noSeverity"
			],
			"group": "build"
		}
	]
}