{
    "version": "1.9",
    "propertyGroups": [
        {
            "name": "Backplane_toolchain",
            "type": "toolchain",
            "provider": "microchip.toolchains:xc8@3.10",
            "properties": {
                "HI-TECH-COMP.asmlist": true,
                "HI-TECH-COMP.define-macros": [
                    "SPI_PERIPHERAL=SPI2",
                    "SPI_DMA=DMA1",
                    "I2C_DMA=DMA2",
                    "ARGB_PWM_PERIPHERAL=PWM2",
                    "ARGB_CLC_PWM_SPI_PERIPHERAL=CLC7",
                    "ARGB_SPI_PERIPHERAL=SPI1",
                    "ARGB_CLC_SPI_OUT_PERIPHERAL=CLC8",
                    "ARGB_DMA=DMA3",
                    "FSM_SKIP_LEGAL_CHECK"
                ],
                "HI-TECH-COMP.warning-level": "-9"
            }
        },
        {
            "name": "ControlBoard_toolchain",
            "type": "toolchain",
            "provider": "microchip.toolchains:xc8@3.10",
            "properties": {
                "HI-TECH-COMP.asmlist": true,
                "HI-TECH-COMP.define-macros": [
                    "SPI_PERIPHERAL=SPI2",
                    "SPI_DMA=DMA1",
                    "I2C_DMA=DMA2",
                    "ARGB_PWM_PERIPHERAL=PWM2",
                    "ARGB_CLC_PWM_SPI_PERIPHERAL=CLC7",
                    "ARGB_SPI_PERIPHERAL=SPI1",
                    "ARGB_CLC_SPI_OUT_PERIPHERAL=CLC8",
                    "ARGB_DMA=DMA3",
                    "FSM_SKIP_LEGAL_CHECK"
                ],
                "HI-TECH-COMP.warning-level": "-9",
                "XC8-config-global.constdata-progmem": false,
                "HI-TECH-COMP.optimization-level": "-O1"
            }
        },
        {
            "name": "Edgework_toolchain",
            "type": "toolchain",
            "provider": "microchip.toolchains:xc8@3.10",
            "properties": {
                "HI-TECH-COMP.asmlist": true,
                "HI-TECH-COMP.define-macros": [
                    "SPI_PERIPHERAL=SPI2",
                    "SPI_DMA=DMA1",
                    "I2C_DMA=DMA2",
                    "ARGB_PWM_PERIPHERAL=PWM2",
                    "ARGB_CLC_PWM_SPI_PERIPHERAL=CLC3",
                    "ARGB_SPI_PERIPHERAL=SPI1",
                    "ARGB_CLC_SPI_OUT_PERIPHERAL=CLC4",
                    "ARGB_DMA=DMA3",
                    "FSM_SKIP_LEGAL_CHECK"
                ],
                "HI-TECH-COMP.warning-level": "-9"
            }
        }
    ],
    "fileSets": [
        {
            "name": "Backplane_files",
            "files": [
                {
                    "include": "**/*",
                    "exclude": "(**/(_build|out|cmake|.vscode)/**/*|**/can.*)"
                }
            ]
        },
        {
            "name": "Edgework_files",
            "files": [
                {
                    "include": "**/*",
                    "exclude": "(**/(_build|out|cmake|.vscode)/**/*|**/can.*)"
                }
            ]
        },
        {
            "name": "ControlBoard_files",
            "files": [
                {
                    "include": "**/*",
                    "exclude": "**/(_build|out|cmake|.vscode)/**/*"
                }
            ]
        }
    ],
    "configurations": [
        {
            "name": "ControlBoard",
            "id": "",
            "device": "PIC18F57Q84",
            "imageType": "library",
            "imagePath": "./out/Common/ControlBoard.a",
            "tool": "PICkit 4",
            "packs": [
                {
                    "name": "PIC18F-Q_DFP",
                    "vendor": "Microchip",
                    "version": "1.30.487"
                }
            ],
            "fileSet": "ControlBoard_files",
            "toolchain": "ControlBoard_toolchain",
            "includeLegacyMacros": true
        },
        {
            "name": "Backplane",
            "id": "",
            "device": "PIC18F25Q43",
            "imageType": "library",
            "imagePath": "./out/Common/Backplane.a",
            "packs": [
                {
                    "name": "PIC18F-Q_DFP",
                    "vendor": "Microchip",
                    "version": "1.30.487"
                }
            ],
            "fileSet": "Backplane_files",
            "toolchain": "Backplane_toolchain",
            "includeLegacyMacros": true
        },
        {
            "name": "Edgework",
            "id": "",
            "device": "PIC18F15Q40",
            "imageType": "library",
            "imagePath": "./out/Common/Edgework.a",
            "tool": "PICkit 4",
            "packs": [
                {
                    "name": "PIC18F-Q_DFP",
                    "vendor": "Microchip",
                    "version": "1.30.487"
                }
            ],
            "fileSet": "Edgework_files",
            "toolchain": "Edgework_toolchain",
            "includeLegacyMacros": true
        }
    ]
}
