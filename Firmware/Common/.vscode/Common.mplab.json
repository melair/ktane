                {
                    "include": "**/*",
                    "exclude": "**/(_build|out|cmake|.vscode)/**/*"
                }
            ]
        },
        {
            "name": "Edgework_files",
            "files": [
                {
                    "include": "**/*",
                    "exclude": "**/(_build|out|cmake|.vscode)/**/*"
                }
            ]
        },
        {
            "name": "ControlBoard_files",
            "files": [
                {
                    "include": "**/*",
                    "exclude": "**/(_build|out|cmake|.vscode)/**/*"
                }
            ]
        }
    ],
    "configurations": [
        {
            "name": "ControlBoard",
            "id": "",
            "device": "PIC18F57Q84",
            "imageType": "library",
            "imagePath": "./out/Common/ControlBoard.a",
