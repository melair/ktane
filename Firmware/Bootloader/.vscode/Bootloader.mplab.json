                {
                    "include": "../Common/.vscode/Common.mplab.json",
                    "type": "project",
                    "projectType": "library",
                    "dependentConfigurationName": "Edgework",
                    "exclude": "false"
                }
            ]
        }
    ],
    "configurations": [
        {
            "name": "ControlBoard",
            "id": "",
            "device": "PIC18F57Q84",
            "imagePath": "./out/Bootloader/ControlBoard.elf",
            "toolProperties": "ControlBoard-tool-base",
            "tool": "PICkit 4",
            "packs": [
                {
                    "name": "PIC18F-Q_DFP",
                    "vendor": "Microchip",
                    "version": "1.30.487"
                }
            ],
            "fileSet": "ControlBoard_files",
            "toolchain": "ControlBoard_toolchain",
            "includeLegacyMacros": true
        },
