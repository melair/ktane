#include <stdint.h>

/*
 * Bitmap font generated by tool font generate glyphs.
 * The shared glyph_t type is intentionally unprefixed; deduplicate it if multiple fonts are generated.
 *
 * Use {{.Prefix}}_ascii_map[(uint8_t)c] to find an index into {{.Prefix}}_glyphs.
 * A map value of -1 means the character is not present.
 * Each glyph's bitmap starts at {{.Prefix}}_bitmap[glyph.data_offset].
 * The glyph row stride is (glyph.width + 7) / 8 bytes.
 * Bits are MSB-first: the leftmost pixel in a byte is bit 7.
 * Pixel values are 0 = white/background and 1 = black/foreground.
 * Render at dst_x = cursor_x + glyph.x_offset and dst_y = baseline_y + glyph.y_offset.
 * Advance cursor_x by glyph.x_advance after rendering.
 */

typedef struct {
	char character;
	uint16_t width;
	uint16_t height;
	int16_t x_offset;
	int16_t y_offset;
	uint16_t x_advance;
	uint32_t data_offset;
} glyph_t;

const uint16_t {{.Prefix}}_line_height = {{.LineHeight}};
const int16_t {{.Prefix}}_ascent = {{.Ascent}};
const int16_t {{.Prefix}}_descent = {{.Descent}};
const uint16_t {{.Prefix}}_glyph_count = {{.GlyphCount}};

const int16_t {{.Prefix}}_ascii_map[128] = {
{{.AsciiMap}}};

const glyph_t {{.Prefix}}_glyphs[] = {
{{.Glyphs}}};

const uint8_t {{.Prefix}}_bitmap[] = {
{{.Bitmap}}};
