	(gr_text "{dblquote}Common misconception that; that fun is relaxing. If it is, you're not doing it right.{dblquote}\nIain M. Banks, The Player of Games"
		(at 70 24 0)
		(layer "B.SilkS")
		(uuid "6c4ba764-5a6e-4947-a455-971232782ecf")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.15)
			)
			(justify top mirror)
		)
	)
	(gr_text "Finally, huge thanks to my \nwife and daughters that support\nmy insane hobbies and suffer\nmy incessant nerdery."
		(at 37 49 0)
		(layer "B.SilkS")
		(uuid "b45b0eaf-5e8c-4eb4-9701-2e4a5b3bee7f")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.15)
			)
			(justify mirror)
		)
	)
	(gr_text "Thanks to my friends that\ncaused me to get into this\nmess, and help with IRL\ntesting - the Narcolepsy crew."
		(at 70 49 0)
		(layer "B.SilkS")
		(uuid "3eaf331f-f90f-4035-b382-358499e0ccc9")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.15)
			)
			(justify mirror)
		)
	)
	(gr_text "Huge thanks to bcorwen, Stella,\nand the KTANE IRL Discord crew\nfor all the inspiration, advice,\nand camaraderie!"
		(at 103 49 0)
		(layer "B.SilkS")
		(uuid "42e4dc0a-4b49-452e-8743-e27e1b86f7fb")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.15)
			)
			(justify mirror)
		)
	)
